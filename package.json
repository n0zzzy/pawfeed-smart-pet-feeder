{
  "name": "smart-pet-feeder",
  "version": "1.0.0",
  "description": "Automatic Smart Pet Feeder web dashboard with Playwright automation tests",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
