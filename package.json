{
  "name": "smart-pet-feeder",
  "version": "1.0.0",
  "description": "Automatic Smart Pet Feeder web + mobile app with login, SQLite database and Playwright automation tests",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "allure": "node scripts/allure-report.js",
    "allure:open": "allure open allure-report",
    "doc": "node docs/capture-report.js && node docs/build-doc.js"
  },
  "author": "Russel Carlo T. Manzon",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure": "3.20.0",
    "allure-playwright": "3.13.0"
  }
}
